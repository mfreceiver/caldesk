<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>CalDesk</Product>
    <Authors>mfreceiver</Authors>
    <Company>mfreceiver</Company>
    <Copyright>Copyright © 2026 mfreceiver</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>

  <!-- Version is derived from git (tags + commit count). Do NOT hand-maintain <Version> here. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Version.props" />
</Project>
