<Application x:Class="CalDesk.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.Light.xaml" />
                <ResourceDictionary Source="Themes/FontSizes.S.xaml" />
                <ResourceDictionary Source="Themes/AppControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="AppFont">Microsoft YaHei UI</FontFamily>
            <tb:TaskbarIcon x:Key="TrayIcon"
                            ToolTipText="CalDesk"
                            TrayLeftMouseDoubleClick="OnShowWindow">
                <tb:TaskbarIcon.IconSource>
                    <BitmapImage UriSource="pack://application:,,,/Assets/app.ico" />
                </tb:TaskbarIcon.IconSource>
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="立即同步" Click="OnSync" />
                        <MenuItem Header="设置" Click="OnSettings" />
                        <MenuItem Header="关于" Click="OnAbout" />
                        <Separator />
                        <MenuItem Header="退出" Click="OnExit" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
