<Application x:Class="CalDesk.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="CalDesk"
                        TrayLeftMouseDoubleClick="OnShowWindow">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="日" Foreground="White" Background="#FF3B82F6" FontWeight="Bold" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="显示桌面窗口" Click="OnShowWindow" />
                    <MenuItem Header="月视图" Click="OnShowMonth" />
                    <MenuItem Header="新增事项" Click="OnQuickAdd" />
                    <MenuItem Header="立即同步" Click="OnSync" />
                    <MenuItem Header="设置" Click="OnSettings" />
                    <Separator />
                    <MenuItem Header="退出" Click="OnExit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
