<Window x:Class="CalDesk.App.Views.WeekWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:CalDesk.App.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:WeekViewModel}"
        Title="CalDesk" Width="330" Height="600"
        MinWidth="320" MinHeight="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI" FontSize="{DynamicResource FontBase}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis" />
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Segmented 周/月 toggle: 周 active in week window; 月 click opens month. -->
        <Style x:Key="ToggleSegment" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToggleSegmentActive" TargetType="Button" BasedOn="{StaticResource ToggleSegment}">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border Background="#F4FFFFFF" CornerRadius="10" Padding="14" MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header: 今天 (left) | ‹ WeekHeader › (center) | 周/月 toggle (right), on a soft band -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBrushWeek}" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="今天" Style="{StaticResource GhostButton}"
                            Command="{Binding TodayCommand}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="‹" Style="{StaticResource GhostButton}"
                                Command="{Binding PrevWeekCommand}" Margin="0,0,2,0" />
                        <TextBlock Text="{Binding WeekHeader}" FontSize="{DynamicResource FontHeader}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="4,0" />
                        <Button Content="›" Style="{StaticResource GhostButton}"
                                Command="{Binding NextWeekCommand}" Margin="2,0,0,0" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="#14000000" CornerRadius="7" Padding="2"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="周" Style="{StaticResource ToggleSegmentActive}"
                                    IsEnabled="False" ToolTip="周视图" />
                            <Button Content="月" Style="{StaticResource ToggleSegment}"
                                    ToolTip="月视图" Click="OnMonth" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- days -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="2,0,6,0">
                <ItemsControl ItemsSource="{Binding Week.Days}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Padding="8,6" Margin="0,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#0D000000" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                <Setter Property="Background" Value="#14000000" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="Background" Value="#143B82F6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel MouseLeftButtonDown="OnDayDoubleAdd">
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Opacity="0.85">
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="{DynamicResource FontBody}" />
                                            <TextBlock Text=" 今天" FontSize="{DynamicResource FontTiny}" Foreground="#3B82F6" Margin="4,0,0,0"
                                                       Visibility="{Binding IsToday, Converter={StaticResource Bool2Vis}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="＋" FontSize="{DynamicResource FontTitle}" Style="{StaticResource GhostButton}"
                                                Command="{Binding DataContext.AddNewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Date}" ToolTip="为该日新增" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding AllDay}" Margin="0,0,0,2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource RowButton}" Margin="0,1"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding EventId}">
                                                    <Border Background="#223B82F6" CornerRadius="4" Padding="6,2" Margin="0,1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="5" Height="5" CornerRadius="2" Margin="0,0,5,0"
                                                                    Background="{Binding Color, TargetNullValue=#3B82F6}" Opacity="0.9"
                                                                    VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Summary}" FontSize="{DynamicResource FontBody}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding Timed}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource RowButton}" Margin="0,1"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding EventId}">
                                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                                        <TextBlock Text="{Binding TimeLabel}" FontSize="{DynamicResource FontSmall}" Foreground="#3B82F6"
                                                                   Width="46" VerticalAlignment="Top" />
                                                        <Border Width="5" Height="5" CornerRadius="2" Margin="2,3,5,0"
                                                                Background="{Binding Color, TargetNullValue=#3B82F6}" Opacity="0.9"
                                                                VerticalAlignment="Top" />
                                                        <TextBlock Text="{Binding Summary}" FontSize="{DynamicResource FontBody}" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOngoing}" Value="True">
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                            <Setter Property="Foreground" Value="#B91C1C" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="暂无事项" FontSize="{DynamicResource FontSmall}" Opacity="0.4" Margin="2,2,0,0"
                                               Visibility="{Binding IsEmpty, Converter={StaticResource Bool2Vis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- status + resize grip (今天 now lives in the header) -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Sync.Status}" Opacity="0.55" FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <!-- Bottom-right grip for borderless CanResize (keeps transparent rounded chrome). -->
                <ResizeGrip Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Width="14" Height="14" Margin="4,0,0,0" Opacity="0.45"
                            Cursor="SizeNWSE" />
            </Grid>
        </Grid>
    </Border>
</Window>
