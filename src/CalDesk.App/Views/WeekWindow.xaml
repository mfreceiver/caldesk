<Window x:Class="CalDesk.App.Views.WeekWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:CalDesk.App.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:WeekViewModel}"
        Title="CalDesk" Width="330" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis" />
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F4FFFFFF" CornerRadius="10" Padding="14" MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="‹" Style="{StaticResource GhostButton}" Command="{Binding PrevWeekCommand}" Margin="0,0,2,0" />
                    <Button Content="›" Style="{StaticResource GhostButton}" Command="{Binding NextWeekCommand}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding WeekHeader}" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="＋" FontSize="17" Style="{StaticResource GhostButton}"
                            Command="{Binding AddNewCommand}" CommandParameter="{x:Null}" ToolTip="新增事项" />
                    <Button Content="月" Style="{StaticResource GhostButton}" ToolTip="月视图" Click="OnMonth" />
                </StackPanel>
            </Grid>

            <!-- days -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="2,0,6,0">
                <ItemsControl ItemsSource="{Binding Week.Days}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,6" MouseLeftButtonDown="OnDayDoubleAdd">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3" Opacity="0.8">
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                    <TextBlock Text=" 今天" FontSize="9" Foreground="#3B82F6" Margin="4,0,0,0"
                                               Visibility="{Binding IsToday, Converter={StaticResource Bool2Vis}}" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding AllDay}" Margin="0,0,0,2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Margin="0,1"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding EventId}">
                                                <Border Background="#223B82F6" CornerRadius="4" Padding="6,2" Margin="0,1">
                                                    <TextBlock Text="{Binding Summary}" FontSize="12" />
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Timed}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Margin="0,1"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding EventId}">
                                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                                    <TextBlock Text="{Binding TimeLabel}" FontSize="11" Foreground="#3B82F6"
                                                               Width="46" VerticalAlignment="Top" />
                                                    <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOngoing}" Value="True">
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                        <Setter Property="Foreground" Value="#B91C1C" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="暂无事项" FontSize="11" Opacity="0.4" Margin="2,2,0,0"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource Bool2Vis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- status -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Sync.Status}" Opacity="0.55" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="今天" Style="{StaticResource GhostButton}" Command="{Binding TodayCommand}" />
            </Grid>
        </Grid>
    </Border>
</Window>
