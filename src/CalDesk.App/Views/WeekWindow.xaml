<Window x:Class="CalDesk.App.Views.WeekWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:CalDesk.App.ViewModels"
        xmlns:controls="clr-namespace:CalDesk.App.Controls"
        xmlns:conv="clr-namespace:CalDesk.App.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:WeekViewModel}"
        Title="CalDesk" Width="330" Height="600"
        MinWidth="320" MinHeight="500"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource SurfaceBrush}"
        ShowInTaskbar="False" ResizeMode="CanResize"
         FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource FontBase}" Foreground="{DynamicResource ForegroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis" />
        <!-- R2/§3.11：色点 MultiBinding 的两个伙伴资源（GhostButton/RowButton/ToggleSegment/
             ToggleSegmentActive 已由 AppControls.xaml 提供，本地副本已删除）。 -->
        <conv:ColorOrAccentConverter x:Key="ColorOrAccent"/>
        <conv:BrushResourceProxy x:Key="AccentProxy" Brush="{DynamicResource AccentBrush}"/>
    </Window.Resources>

    <!-- Spike T7S: opaque + WindowChrome; DropShadowEffect removed (DWM shadow via DwmAppearance). -->
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14" MouseLeftButtonDown="OnDrag">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header: 今天 (left) | ‹ WeekHeader › (center) | 周/月 toggle (right), on a soft band -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                <Grid>
                    <!-- 标题：占满整行宽度，严格居中；放最底层 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="0">
                        <Button Content="‹" Style="{StaticResource GhostButton}" Command="{Binding PrevWeekCommand}" Margin="0,0,2,0" />
                        <TextBlock Text="{Binding WeekHeader}" FontSize="{DynamicResource FontHeader}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="4,0" />
                        <Button Content="›" Style="{StaticResource GhostButton}" Command="{Binding NextWeekCommand}" Margin="2,0,0,0" />
                    </StackPanel>
                    <!-- 左：今天，贴左、置顶 -->
                    <Button Content="今天" Style="{StaticResource GhostButton}" Command="{Binding TodayCommand}"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Panel.ZIndex="1" />
                    <!-- 右：周/月 toggle，贴右、置顶 -->
                    <Border Background="{DynamicResource HoverOverlayBrush}" CornerRadius="7" Padding="2"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Panel.ZIndex="1">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="周" Style="{StaticResource ToggleSegmentActive}" IsEnabled="False" ToolTip="周视图" />
                            <Button Content="月" Style="{StaticResource ToggleSegment}" ToolTip="月视图" Click="OnMonth" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- days (W1: SlimScrollViewer + 对称 Padding，右 12 留给 overlay 不遮内容) -->
            <ScrollViewer x:Name="WeekScrollViewer" Grid.Row="1" Style="{StaticResource SlimScrollViewer}"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Week.Days}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:WeekDaysPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- W2/W4：日卡 Padding 12,8 + 1px 边框；bg/border 走 Style.Triggers（非本地属性） -->
                            <Border CornerRadius="6" Padding="12,8" Margin="0,4" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource DayCardBrush}" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource WeekendOverlayBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource TodayBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                    <StackPanel MouseLeftButtonDown="OnDayDoubleAdd">
                                        <Grid Margin="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Opacity="0.85" VerticalAlignment="Center">
                                                <!-- W2: SemiBold 必须在 Style Setter，IsToday→Bold 才能覆盖（本地值会压 trigger） -->
                                                <TextBlock Text="{Binding Header}" FontSize="{DynamicResource FontBody}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="＋" Style="{StaticResource AddButton}"
                                                    Command="{Binding DataContext.AddNewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Date}" ToolTip="为该日新增" />
                                        </Grid>

                                    <ItemsControl ItemsSource="{Binding AllDay}" Margin="0,0,0,2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource RowButton}" Margin="0,1"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding EventId}">
                                                    <!-- all-day 行：外裹 AccentSoftBrush pill，Grid 2 列 [Auto 色点][* Summary] -->
                                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" Margin="0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="5" Height="5" CornerRadius="2" Margin="0,0,5,0"
                                                                    VerticalAlignment="Center" Opacity="0.9">
                                                                <Border.Background>
                                                                    <MultiBinding Converter="{StaticResource ColorOrAccent}">
                                                                        <Binding Path="Color" />
                                                                        <Binding Source="{StaticResource AccentProxy}" Path="Brush" />
                                                                    </MultiBinding>
                                                                </Border.Background>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="{DynamicResource FontBody}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding Timed}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource RowButton}" Margin="0,1"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding EventId}">
                                                    <!-- W5/W6: timed 行 Grid 3 列 [46 TimeLabel][Auto 色点][* Summary] -->
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" FontSize="{DynamicResource FontSmall}"
                                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Width="5" Height="5" CornerRadius="2" Margin="0,0,5,0"
                                                                VerticalAlignment="Center" Opacity="0.9">
                                                            <Border.Background>
                                                                <MultiBinding Converter="{StaticResource ColorOrAccent}">
                                                                    <Binding Path="Color" />
                                                                    <Binding Source="{StaticResource AccentProxy}" Path="Brush" />
                                                                </MultiBinding>
                                                            </Border.Background>
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="{DynamicResource FontBody}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOngoing}" Value="True">
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="暂无事项" FontSize="{DynamicResource FontSmall}" Opacity="0.4" Margin="2,2,0,0"
                                               Visibility="{Binding IsEmpty, Converter={StaticResource Bool2Vis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- status + resize grip (今天 now lives in the header) -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Sync.Status}" Opacity="0.55" FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <!-- Bottom-right grip for borderless CanResize (keeps transparent rounded chrome). -->
                <ResizeGrip Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Width="14" Height="14" Margin="4,0,0,0" Opacity="0.45"
                            Cursor="SizeNWSE" />
            </Grid>
        </Grid>
    </Border>
</Window>
