<Window x:Class="CalDesk.App.Views.MonthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:CalDesk.App.ViewModels"
        xmlns:conv="clr-namespace:CalDesk.App.Converters"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MonthViewModel}"
        Title="CalDesk 月视图" Width="380" Height="640"
        MinWidth="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="CanResize"
        FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource FontBase}"
        Loaded="OnLoaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis" />
        <conv:ColorOrAccentConverter x:Key="ColorOrAccent" />
        <conv:BrushResourceProxy x:Key="AccentProxy" Brush="{DynamicResource AccentBrush}" />
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12" MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" Color="Black" />
        </Border.Effect>
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- header -->
                <RowDefinition Height="Auto" />   <!-- weekday headers -->
                <RowDefinition Height="3*" />     <!-- top month grid (MinHeight via ComputeBottomLimits) -->
                <RowDefinition Height="Auto" />   <!-- hairline (M5) -->
                <RowDefinition Height="2*" />     <!-- bottom day detail (Min/Max via ComputeBottomLimits) -->
                <RowDefinition Height="Auto" />   <!-- status -->
            </Grid.RowDefinitions>

            <!-- header: 今天 (left) | ‹ MonthHeader › (center) | 周/月 toggle (right), on a soft band -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="今天" Style="{StaticResource GhostButton}"
                            Command="{Binding TodayCommand}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="‹" Style="{StaticResource GhostButton}"
                                Command="{Binding PrevMonthCommand}" Margin="0,0,2,0" />
                        <TextBlock Text="{Binding MonthHeader}" FontSize="{DynamicResource FontHeader}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="4,0" />
                        <Button Content="›" Style="{StaticResource GhostButton}"
                                Command="{Binding NextMonthCommand}" Margin="2,0,0,0" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="{DynamicResource HoverOverlayBrush}" CornerRadius="7" Padding="2"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="周" Style="{StaticResource ToggleSegment}"
                                    ToolTip="周视图" Click="OnBackToWeek" />
                            <Button Content="月" Style="{StaticResource ToggleSegmentActive}"
                                    IsEnabled="False" ToolTip="月视图" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- weekday header row -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding WeekdayHeaders}" Margin="0,0,0,2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="{DynamicResource FontMicro}" Opacity="0.5" HorizontalAlignment="Center" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- month grid: 6 equal-height rows (weeks); each row = 7 day cells -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Month.Weeks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="6" Columns="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding Days}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Cell is the only month-grid command; preview rows are inert. -->
                                    <Button Style="{StaticResource RowButton}" Margin="1"
                                            Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Date}">
                                        <Border Padding="2,1" CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource DayCardBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInMonth}" Value="False">
                                                            <Setter Property="Opacity" Value="0.35" />
                                                            <Setter Property="Background" Value="Transparent" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                            <TextBlock Text="{Binding Day}" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                       FontSize="{DynamicResource FontMonthDate}" FontWeight="Bold" Opacity="0.28" />
                                            <StackPanel VerticalAlignment="Top" Margin="0,18,0,0">
                                                <ItemsControl ItemsSource="{Binding Preview}" IsHitTestVisible="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid IsHitTestVisible="False">
                                                                <!-- M2 月格：2 列 [色点|Summary]，不显 TimeLabel（R11） -->
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Width="5" Height="5" CornerRadius="2" Margin="0,0,3,0"
                                                                            Opacity="0.85" VerticalAlignment="Center">
                                                                        <Border.Background>
                                                                            <MultiBinding Converter="{StaticResource ColorOrAccent}">
                                                                                <Binding Path="Color" />
                                                                                <Binding Source="{StaticResource AccentProxy}" Path="Brush" />
                                                                            </MultiBinding>
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Summary}"
                                                                               FontSize="{DynamicResource FontMonthCell}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- Overflow indicator (+N): clicking the cell already triggers SelectDay -->
                                                <TextBlock Text="{Binding OverflowCount, StringFormat={}+{0}}"
                                                           FontSize="{DynamicResource FontMonthCell}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}" Margin="2,0,0,0"
                                                           Visibility="{Binding HasOverflow, Converter={StaticResource Bool2Vis}}" />
                                            </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- M5: static hairline (GridSplitter removed) -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Margin="0,2,0,2" SnapsToDevicePixels="True" />

            <!-- bottom day-detail: header line + per-day ＋, then all-day + timed events -->
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Padding="2,0,6,0">
                <StackPanel Margin="0,1,0,0">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedDay.Header, FallbackValue=该日无事项}"
                                   FontWeight="SemiBold" FontSize="{DynamicResource FontBody}" />
                        <Button Grid.Column="1" Content="＋" FontSize="{DynamicResource FontTitle}" ToolTip="为该日新增"
                                Command="{Binding AddNewCommand}" CommandParameter="{Binding SelectedDate}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDate}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- null-state: SelectedDay not built yet -->
                    <TextBlock Text="该日无事项" FontSize="{DynamicResource FontSmall}" Opacity="0.4" Margin="2,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDay}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- day body (visible only when SelectedDay != null) -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDay}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- all-day events: W5/W6 3-col grid, AccentSoft pill -->
                        <ItemsControl ItemsSource="{Binding SelectedDay.AllDay}" Margin="0,0,0,2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}" Margin="0,1"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding EventId}">
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" Margin="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TimeRangeLabel}"
                                                           FontSize="{DynamicResource FontSmall}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="1" Width="5" Height="5" CornerRadius="2" Margin="0,0,5,0"
                                                        Opacity="0.9" VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <MultiBinding Converter="{StaticResource ColorOrAccent}">
                                                            <Binding Path="Color" />
                                                            <Binding Source="{StaticResource AccentProxy}" Path="Brush" />
                                                        </MultiBinding>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                                           FontSize="{DynamicResource FontBody}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- timed events: W5/W6 Grid 3 列 [TimeLabel|色点|Summary] -->
                        <ItemsControl ItemsSource="{Binding SelectedDay.Timed}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}" Margin="0,1"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding EventId}">
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TimeRangeLabel}"
                                                       FontSize="{DynamicResource FontSmall}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Width="5" Height="5" CornerRadius="2" Margin="0,0,5,0"
                                                    Opacity="0.9" VerticalAlignment="Center">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource ColorOrAccent}">
                                                        <Binding Path="Color" />
                                                        <Binding Source="{StaticResource AccentProxy}" Path="Brush" />
                                                    </MultiBinding>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                                       FontSize="{DynamicResource FontBody}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOngoing}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- in-month empty-day hint -->
                        <TextBlock Text="该日无事项" FontSize="{DynamicResource FontSmall}" Opacity="0.4" Margin="2,2,0,0"
                                   Visibility="{Binding SelectedDay.IsEmpty, Converter={StaticResource Bool2Vis}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- status + resize grip (今天 now lives in the header) -->
            <Grid Grid.Row="5" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Sync.Status}" Opacity="0.55" FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <!-- Bottom-right grip for borderless CanResize (keeps transparent rounded chrome). -->
                <ResizeGrip Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Width="14" Height="14" Margin="4,0,0,0" Opacity="0.45"
                            Cursor="SizeNWSE" />
            </Grid>
        </Grid>
    </Border>
</Window>
