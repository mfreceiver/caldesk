<Window x:Class="CalDesk.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:CalDesk.App.ViewModels"
        xmlns:m="clr-namespace:CalDesk.App.Models"
        xmlns:core="clr-namespace:CalDesk.Core.Services;assembly=CalDesk.Core"
        xmlns:conv="clr-namespace:CalDesk.App.Converters"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="设置" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="{DynamicResource FontBase}">
    <Window.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <conv:EqualsConverter x:Key="EqualsConv" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== CalDAV 账户 ===== -->
        <GroupBox Grid.Row="0" Header="CalDAV 账户" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="地址" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Padding="4" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="用户名" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="4" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="密码" VerticalAlignment="Top" Margin="0,6,0,0" />
                    <!-- Grid.Column="1" is required — without it the box collapses into the label column.
                         Password stays empty on open; HasStoredPassword drives the hint (empty box = keep stored). -->
                    <StackPanel Grid.Column="1">
                        <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" Padding="4" />
                        <TextBlock Text="{Binding PasswordHint}" FontSize="{DynamicResource FontSmall}" Opacity="0.7" Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Content="接受不安全的 TLS 连接" IsChecked="{Binding AcceptInsecureTls}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="同步间隔(分)" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7" />
                        <TextBox Text="{Binding SyncIntervalMinutes}" Width="54" Padding="4" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="4" Text="{Binding StatusText}" Opacity="0.7" Margin="0,0,0,6" TextWrapping="Wrap" />

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="测试连接" Command="{Binding TestConnectionCommand}" Padding="14,4" Margin="0,0,8,0"
                            IsEnabled="{Binding CanTestConnection}" />
                    <Button Content="保存连接信息" Command="{Binding SaveAccountCommand}" Padding="14,4"
                            IsEnabled="{Binding CanSaveAccount}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ===== 日历管理（隐藏 + 12 色声明式色板 §3.12） ===== -->
        <GroupBox Grid.Row="1" Header="日历管理" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="勾选显示该日历；点击色块为该日历配色。" Opacity="0.7"
                           Margin="0,0,0,6" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding CalendarRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Center" TextBlock.FontSize="{DynamicResource FontBody}" />
                                <!-- S3：声明式色板 — ControlTemplate.Triggers 承载选中三件套
                                     （外环 AccentBrush + 内白描边 SwatchRingBrush + 白勾 Path） -->
                                <ItemsControl Grid.Column="1"
                                              ItemsSource="{x:Static core:CalendarPalette.Presets}"
                                              Margin="8,0,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="20" Height="20" Margin="2,0" Padding="0"
                                                    Cursor="Hand" ToolTip="{Binding}" Click="OnPickColor">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Ring" CornerRadius="5" BorderThickness="2"
                                                                BorderBrush="Transparent" Background="Transparent" IsHitTestVisible="True">
                                                            <Grid>
                                                                <Border CornerRadius="3" Background="{Binding}" />
                                                                <Border x:Name="InnerRing" CornerRadius="3"
                                                                        BorderBrush="{DynamicResource SwatchRingBrush}"
                                                                        BorderThickness="1.5" Visibility="Collapsed" />
                                                                <Path x:Name="Check"
                                                                      Data="M 4,8.5 L 7,11.5 L 12,5"
                                                                      Stroke="{DynamicResource SwatchRingBrush}"
                                                                      StrokeThickness="1.8"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Visibility="Collapsed" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource EqualsConv}">
                                                                        <Binding />
                                                                        <Binding Path="DataContext.Color"
                                                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter TargetName="Ring" Property="BorderBrush"
                                                                        Value="{DynamicResource AccentBrush}" />
                                                                <Setter TargetName="InnerRing" Property="Visibility"
                                                                        Value="Visible" />
                                                                <Setter TargetName="Check" Property="Visibility"
                                                                        Value="Visible" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Ring" Property="Background"
                                                                        Value="{DynamicResource HoverOverlayBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="（连接服务器并同步后才会出现日历）" Opacity="0.5"
                           FontSize="{DynamicResource FontSmall}" Margin="0,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCalendars}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <!-- ===== 桌面窗口 ===== -->
        <GroupBox Grid.Row="2" Header="桌面窗口" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="窗口模式" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton Content="正常窗口" GroupName="WindowMode" Margin="0,0,12,0"
                                     IsChecked="{Binding WindowMode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static m:WindowMode.Normal}, Mode=TwoWay}" />
                        <RadioButton Content="固定到桌面底层" GroupName="WindowMode" Margin="0,0,12,0"
                                     IsChecked="{Binding WindowMode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static m:WindowMode.Desktop}, Mode=TwoWay}" />
                        <RadioButton Content="始终置顶" GroupName="WindowMode"
                                     IsChecked="{Binding WindowMode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static m:WindowMode.Topmost}, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="透明度" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="0.15" Maximum="1.0" Value="{Binding Opacity}" TickFrequency="0.05" />
                    <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat=P0}" VerticalAlignment="Center" />
                </Grid>

                <CheckBox Grid.Row="2" Content="锁定位置（仅桌面底层模式生效）" Margin="0,0,0,4"
                          IsChecked="{Binding LockedPosition}" IsEnabled="{Binding IsLockPositionEnabled}" />
                <CheckBox Grid.Row="3" Content="开机启动" IsChecked="{Binding StartWithWindows}" />
            </Grid>
        </GroupBox>

        <!-- ===== 默认属性 ===== -->
        <GroupBox Grid.Row="3" Header="默认属性" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="默认日历" VerticalAlignment="Center" />
                    <Grid Grid.Column="1">
                        <ComboBox ItemsSource="{Binding Calendars}" SelectedItem="{Binding SelectedCalendar}"
                                  DisplayMemberPath="DisplayName" IsEnabled="{Binding HasCalendars}" />
                        <TextBlock Text="（连接服务器后可选）" VerticalAlignment="Center" Opacity="0.5" FontSize="{DynamicResource FontSmall}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCalendars}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="默认时长(分)" Opacity="0.7" />
                        <TextBox Text="{Binding DefaultDurationMinutes}" Padding="4" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="默认提醒(分)" Opacity="0.7" />
                        <TextBox Text="{Binding DefaultReminderMinutes}" Padding="4" />
                    </StackPanel>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- ===== 显示（主题 + 字号 S/M/L） ===== -->
        <GroupBox Grid.Row="4" Header="显示" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="主题" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton Content="跟随系统" GroupName="Theme" Margin="0,0,12,0"
                                 IsChecked="{Binding Theme, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static m:AppThemeMode.FollowSystem}, Mode=TwoWay}" />
                    <RadioButton Content="浅色" GroupName="Theme" Margin="0,0,12,0"
                                 IsChecked="{Binding Theme, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static m:AppThemeMode.Light}, Mode=TwoWay}" />
                    <RadioButton Content="深" GroupName="Theme"
                                 IsChecked="{Binding Theme, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static m:AppThemeMode.Dark}, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="字号" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <RadioButton Content="小 (S)" GroupName="FontSize" Margin="0,0,12,0"
                                 IsChecked="{Binding FontSize, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static m:FontSizeLevel.Small}, Mode=TwoWay}" />
                    <RadioButton Content="中 (M)" GroupName="FontSize" Margin="0,0,12,0"
                                 IsChecked="{Binding FontSize, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static m:FontSizeLevel.Medium}, Mode=TwoWay}" />
                    <RadioButton Content="大 (L)" GroupName="FontSize"
                                 IsChecked="{Binding FontSize, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static m:FontSizeLevel.Large}, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ===== 底部：主保存（含日历本地 upsert）+ 关闭 ===== -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="保存" Command="{Binding SavePropertiesCommand}" Padding="20,6" Margin="0,0,8,0" IsDefault="True" />
            <Button Content="关闭" Padding="20,6" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
