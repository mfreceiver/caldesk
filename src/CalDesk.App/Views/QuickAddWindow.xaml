<Window x:Class="CalDesk.App.Views.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:CalDesk.App.ViewModels"
        xmlns:conv="clr-namespace:CalDesk.App.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:QuickAddViewModel}"
        Title="新增 / 编辑事项" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource SurfaceBrush}"
        ShowInTaskbar="False"
         FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource FontBase}" Foreground="{DynamicResource ForegroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis" />
        <conv:RepeatOptionLabelConverter x:Key="RepeatOptionLabel" />
    </Window.Resources>

    <!-- T12: opaque + WindowChrome; DropShadowEffect removed (DWM shadow via DwmAppearance).
         Card surface: matches the main windows (WeekWindow/MonthWindow) — borderless, rounded SurfaceBrush card. -->
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16"
            TextOptions.TextFormattingMode="Display"
            TextOptions.TextRenderingMode="Auto">

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: title / drag row + close button -->
                <RowDefinition Height="Auto" />
                <!-- 1: 标题 -->
                <RowDefinition Height="Auto" />
                <!-- 2: 开始时间 -->
                <RowDefinition Height="Auto" />
                <!-- 3: 结束时间 -->
                <RowDefinition Height="Auto" />
                <!-- 4: 地点 -->
                <RowDefinition Height="Auto" />
                <!-- 5: 日历 -->
                <RowDefinition Height="Auto" />
                <!-- 6: 提醒 -->
                <RowDefinition Height="Auto" />
                <!-- 7: 重复（高级） -->
                <RowDefinition Height="Auto" />
                <!-- 8: 更多选项 -->
                <RowDefinition Height="Auto" />
                <!-- 9: 错误 -->
                <RowDefinition Height="Auto" />
                <!-- 10: 底部按钮栏 -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title / drag row: drag area (left) + × close (right). The drag
                 area is the empty Grid background — clicking anywhere on the
                 row (other than the close button) initiates DragMove. -->
            <Grid Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="OnDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="事项"
                           FontSize="{DynamicResource FontHeader}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="×"
                        Style="{StaticResource CardGhostButton}"
                        Foreground="{DynamicResource MutedForegroundBrush}"
                        FontSize="{DynamicResource FontHeader}"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        ToolTip="关闭"
                        IsCancel="True"
                        Click="OnClose" />
            </Grid>

            <!-- 标题 -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="标题" VerticalAlignment="Center" Opacity="0.7" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource CardTextBox}"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!-- 开始：日期始终可见；时间仅非全天 -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="开始时间" VerticalAlignment="Center" Opacity="0.7" />
                <DatePicker Grid.Column="1"
                            Style="{StaticResource CardDatePicker}"
                            SelectedDate="{Binding StartDate}"
                            SelectedDateFormat="Short"
                            Language="zh-CN"
                            Margin="0,0,8,0" />
                <TextBox Grid.Column="2"
                         Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}"
                         Width="64"
                         ToolTip="时间：0930 或 09:30"
                         Visibility="{Binding HasTime, Converter={StaticResource Bool2Vis}}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource CardTextBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StartTimeInvalid}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>

            <!-- 结束：日期始终可见（全天可编辑 EndDate）；时间仅非全天 -->
            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="结束时间" VerticalAlignment="Center" Opacity="0.7" />
                <DatePicker Grid.Column="1"
                            SelectedDate="{Binding EndDate}"
                            SelectedDateFormat="Short"
                            Language="zh-CN"
                            Margin="0,0,8,0">
                    <DatePicker.Style>
                        <Style TargetType="DatePicker" BasedOn="{StaticResource CardDatePicker}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RangeInvalid}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DatePicker.Style>
                </DatePicker>
                <TextBox Grid.Column="2"
                         Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}"
                         Width="64"
                         ToolTip="时间：0930 或 09:30"
                         Visibility="{Binding HasTime, Converter={StaticResource Bool2Vis}}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource CardTextBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EndTimeInvalid}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RangeInvalid}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>

            <!-- 地点（始终可见，在日历之上） -->
            <Grid Grid.Row="4" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="地点" VerticalAlignment="Center" Opacity="0.7" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource CardTextBox}"
                         Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!-- 日历 -->
            <Grid Grid.Row="5" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="日历" VerticalAlignment="Center" Opacity="0.7" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Calendars}"
                          SelectedItem="{Binding SelectedCalendar}"
                          DisplayMemberPath="DisplayName">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource CardComboBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CalendarInvalid}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
            </Grid>

            <!-- 提醒 -->
            <Grid Grid.Row="6" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="提醒" VerticalAlignment="Center" Opacity="0.7" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox Style="{StaticResource CardTextBox}"
                             Text="{Binding ReminderMinutes, UpdateSourceTrigger=PropertyChanged}"
                             Width="56" />
                    <TextBlock Text=" 分钟前" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 重复（更多选项内） -->
            <Grid Grid.Row="7" Margin="0,0,0,8" Visibility="{Binding HasAdvanced, Converter={StaticResource Bool2Vis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="重复" VerticalAlignment="Center" Opacity="0.7" />
                <ComboBox Grid.Column="1"
                          Style="{StaticResource CardComboBox}"
                          ItemsSource="{Binding RepeatOptions}"
                          SelectedItem="{Binding Repeat}">
                    <!-- CQ-001: label template gives Custom its "keep as-is" display text;
                         RepeatOptions itself excludes Custom while creating. -->
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource RepeatOptionLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <Button Grid.Row="8" Content="[ 更多选项 ]"
                    Style="{StaticResource CardGhostButton}"
                    Command="{Binding MoreCommand}"
                    Foreground="{DynamicResource AccentBrush}"
                    HorizontalAlignment="Left"
                    Margin="64,0,0,8" />

            <!-- 校验错误（非空时显示） -->
            <TextBlock Grid.Row="9"
                       Text="{Binding Error}"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="{DynamicResource FontSmall}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Visibility="{Binding HasError, Converter={StaticResource Bool2Vis}}" />

            <!-- 底部：全天（左下）+ 删除 | 保存 / 取消 -->
            <Grid Grid.Row="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="全天"
                              Style="{StaticResource CardCheckBox}"
                              IsChecked="{Binding IsAllDay}"
                              Margin="0,0,12,0" />
                    <Button Content="删除"
                            Style="{StaticResource CardGhostButton}"
                            Command="{Binding DeleteCommand}"
                            Foreground="{DynamicResource DangerBrush}"
                            Visibility="{Binding IsEditing, Converter={StaticResource Bool2Vis}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="保存"
                            Style="{StaticResource CardPrimaryButton}"
                            Command="{Binding SaveCommand}"
                            Margin="0,0,8,0"
                            IsDefault="True" />
                    <Button Content="取消"
                            Style="{StaticResource CardButton}"
                            Command="{Binding CancelCommand}"
                            IsCancel="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
