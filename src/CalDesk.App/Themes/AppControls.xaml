<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared "card" control styles for the light rounded-card surfaces
         (QuickAddWindow, and available for any future card-style surface).
         All styles are KEYED (Card*) so they only apply where referenced
         explicitly via Style="{StaticResource CardXxx}". They do NOT change
         the default look of WeekWindow/MonthWindow/SettingsWindow, which all
         use their own keyed button styles (GhostButton/ToggleSegment/RowButton)
         or the OS defaults.

         Palette (kept consistent with the main windows' light card):
           - card surface : #F4FFFFFF (set on the host Border, not here)
           - control bg   : #FFFFFFFF
           - border       : #FFE5E7EB
           - foreground   : #FF1F2937
           - accent (primary)  : #FF3B82F6  / hover #FF2563EB
           - danger (delete)   : #FFB91C1C
    -->

    <!-- TextBox: rounded, subtle border, body font size. -->
    <Style x:Key="CardTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
        <Setter Property="Foreground" Value="#FF1F2937" />
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#FFE5E7EB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="#FF1F2937" />
        <Setter Property="SelectionBrush" Value="#223B82F6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFD1D5DB" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3B82F6" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: keep OS drop-down chrome (so the popup template stays native
         and consistent), but unify font + border + padding. Border-only style. -->
    <Style x:Key="CardComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
        <Setter Property="Foreground" Value="#FF1F2937" />
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#FFE5E7EB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- DatePicker: same approach — keep native popup, unify surface props. -->
    <Style x:Key="CardDatePicker" TargetType="DatePicker">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
        <Setter Property="Foreground" Value="#FF1F2937" />
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#FFE5E7EB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- CheckBox: align font + sizing with the rest of the card. -->
    <Style x:Key="CardCheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
        <Setter Property="Foreground" Value="#FF1F2937" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Button (neutral): rounded, subtle border, body font size. Hover lightens bg.
         This is the base for the primary + ghost variants below. -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
        <Setter Property="Foreground" Value="#FF1F2937" />
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#FFE5E7EB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFF3F4F6" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFD1D5DB" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFE5E7EB" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary action button (e.g. 保存): blue accent, white text. -->
    <Style x:Key="CardPrimaryButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
        <Setter Property="Background" Value="#FF3B82F6" />
        <Setter Property="BorderBrush" Value="#FF3B82F6" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <!-- Re-skin the hover/pressed states inherited from CardButton
                 so the accent reads correctly on the primary button. -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF2563EB" />
                <Setter Property="BorderBrush" Value="#FF2563EB" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FF1D4ED8" />
                <Setter Property="BorderBrush" Value="#FF1D4ED8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ghost / link-style button (× close, [更多选项], 删除): transparent,
         borderless, hand cursor. Caller sets Foreground for tone
         (e.g. #FFB91C1C for 删除, #FF3B82F6 for 更多选项, #FF6B7280 for ×). -->
    <Style x:Key="CardGhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
        <Setter Property="Foreground" Value="#FF1F2937" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14000000" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22000000" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
